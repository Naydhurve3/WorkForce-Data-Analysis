# WorkForce Data Analysis v2.0 - Environment Configuration
# Copy to .env and fill in your values

# Data paths
DATA_RAW_PATH=data/raw/employee_data.csv
DATA_INTERIM_DIR=data/interim/
DATA_PROCESSED_DIR=data/processed/

# Pipeline settings
PIPELINE_SEED=42
LOG_LEVEL=INFO

# Model paths
MODEL_IMPUTATION_DIR=models/imputation/
MODEL_NLP_DIR=models/nlp/
MODEL_FORECASTING_DIR=models/forecasting/

# Streamlit
STREAMLIT_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
